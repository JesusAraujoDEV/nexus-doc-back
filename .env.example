# Entorno
NODE_ENV=development
PORT=3000

# Base de datos (cadena de conexión única)
DB_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Seguridad
JWT_SECRET=change_me

# URLs
CLIENT_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# CORS (separado por comas)
CORS_WHITELIST=http://localhost:3000

# Adjuntos en Cloudflare R2 (bucket privado). Pasos: docs/guides/adjuntos-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexusdoc-adjuntos

# Sincronización desde la laptop de la doctora (data/sync-laptop). Token largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LEGACY_SYNC_TOKEN=
# Carpeta donde quedan los últimos paquetes y respaldos (montar un volumen en Dokploy)
LEGACY_SYNC_DIR=
